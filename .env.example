# ─── The Sketchy Studio — Environment Variables ───────────────────────────────
# Add these to Vercel: Project → Settings → Environment Variables
# ──────────────────────────────────────────────────────────────────────────────

# Firebase Realtime Database URL (from Firebase console → Realtime Database)
# Looks like: https://sketchy-studio-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app

# Studio passcode — protects /studio from clients
# Share this with your team. Change it whenever someone leaves.
VITE_STUDIO_PASS=your_team_passcode_here
